# Sentinel ASI: wzór konfiguracji. Skopiuj do .env i uzupełnij.
# Plik .env NIE trafia do repozytorium.

# --- ogólne ---
APP_ENV=development
LOG_LEVEL=INFO
# Tryb demo: zezwala seed_demo na zgodę L2 wyłącznie w sieci demo-lab. Domyślnie wyłączony.
DEMO_MODE=false
# Do kiedy obowiązuje zgoda seed_demo (ISO 8601, UTC). Pusta wartość = brak zgody.
DEMO_APPROVAL_EXPIRES_AT=
# CIDR wewnętrznej sieci demo-lab (musi zgadzać się z docker-compose.yml).
DEMO_LAB_CIDR=172.30.99.0/24

# --- baza danych ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- kolejka ---
REDIS_URL=redis://redis:6379/0

# --- zakres skanowania ---
# Plik z allowlistą domen i CIDR. Domyślnie pusty zakres: nic nie jest dozwolone.
SCOPE_FILE=/app/rules/scope.yaml

# --- API i frontend ---
API_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- LLM (lokalnie, Ollama) ---
OLLAMA_URL=http://ollama:11434
# Model wybierany po ewaluacji w eval/RESULTS.md (Etap 3).
LLM_MODEL=
LLM_NUM_CTX=4096
# 0 = wykryj liczbę fizycznych rdzeni automatycznie
LLM_NUM_THREAD=0
OLLAMA_KEEP_ALIVE=-1

# --- zewnętrzny LLM: domyślnie WYŁĄCZONY, dostaje tylko dane zanonimizowane ---
EXTERNAL_LLM_ENABLED=false
EXTERNAL_LLM_API_KEY=

# --- feedy ---
# offline = snapshoty z plików (domyślna ścieżka demo), online = pobieranie z sieci
FEEDS_MODE=offline
NVD_API_KEY=

# --- powiadomienia ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
