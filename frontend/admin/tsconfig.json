{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../shared/src/*"] },
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.admin.tsbuildinfo"
  },
  "include": ["src", "../shared/src"],
  "exclude": [
    "../shared/src/components/CoverageTrend.tsx",
    "../shared/src/components/devices.tsx",
    "../shared/src/components/freshness.tsx",
    "../shared/src/lib/devices.ts"
  ]
}
